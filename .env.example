# DUE 백엔드 환경변수 예시
# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
# ★ API 키를 코드에 삽입하지 않는다. 환경변수만 쓴다.

# Claude API (Phase 4 부터 사용)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# AI 호출 타임아웃(초). 데모에서 멈춰 보이면 안 된다
AI_TIMEOUT_SECONDS=8

# 서버 포트
PORT=8080

# CORS 허용 오리진. 쉼표로 구분. 배포 시 프론트 도메인 추가
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── AI 요금을 막는 두 겹의 상한 ──────────────────────────────
# 공개 주소에 붙은 AI 엔드포인트는 남이 반복 호출하면 그대로 요금이 된다.

# 한 요청자(IP)가 1분에 부를 수 있는 /api/extract · /api/explain 횟수. 0 이면 제한 없음
AI_RATE_PER_MIN=6

# 하루 총 AI 호출 상한. 넘으면 데모 캐시로 답하고(있으면), 없으면 503.
# 판정(/api/evaluate)은 이 상한과 무관하게 계속 동작한다
AI_DAILY_LIMIT=300

# ★ true 면 AI 호출 없이 data/demo-cache.json 의 응답을 쓴다.
# API 키도 네트워크도 필요 없다. 현장 와이파이가 죽어도 데모가 완주된다.
# 자세한 내용은 DEMO.md 참조
DEMO_MODE=false

# true 면 요청마다 제도 JSON 을 다시 읽는다. 팀원이 JSON 을 고치면 바로 반영된다
RELOAD_PROGRAMS=false
